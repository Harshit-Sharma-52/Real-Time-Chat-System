# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/chatapp

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# CORS (comma-separated origins allowed in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI provider (optional — the app works fully without it)
# Set AI_PROVIDER=gemini and provide a key to enable the AI layer.
# Leave AI_PROVIDER=none (default) to disable AI features gracefully.
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
